{
  "name": "@electrobun-reactive-data/notes-consumer",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:native": "electrobun prepare",
    "typecheck": "tsc --noEmit",
    "build:view": "vite build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "build": "npm run typecheck && npm run build:view && npm run check:boundaries && electrobun config --env=dev",
    "native:build": "npm run build:view && electrobun build --env=dev",
    "native:run": "electrobun run --env=dev"
  },
  "dependencies": {
    "@jugyo/electrobun-reactive-data": "file:vendor/jugyo-electrobun-reactive-data-0.0.0-poc.tgz",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "electrobun": "2.0.1",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
