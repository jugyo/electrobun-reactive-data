{
  "name": "@jugyo/electrobun-reactive-data",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Typed reactive SQLite data for local Electrobun applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jugyo/electrobun-reactive-data.git"
  },
  "homepage": "https://github.com/jugyo/electrobun-reactive-data#readme",
  "bugs": {
    "url": "https://github.com/jugyo/electrobun-reactive-data/issues"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./main": "./src/main/index.ts",
    "./client": "./src/client/index.ts",
    "./react": "./src/react/index.tsx"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint && npm run check:boundaries",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "build": "npm run typecheck && npm run check:boundaries && npm run check:exports",
    "example:check": "node scripts/check-example.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "native:acceptance": "node scripts/native-acceptance.mjs",
    "prepack": "npm run typecheck && npm run check:exports",
    "prepare:native": "electrobun prepare",
    "dev": "npm --prefix examples/notes run dev"
  },
  "peerDependencies": {
    "electrobun": "2.0.1",
    "react": "19.1.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "electrobun": "2.0.1",
    "happy-dom": "20.14.0",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
