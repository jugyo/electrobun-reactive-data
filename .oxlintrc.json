{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error" },
  "rules": { "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }] },
  "ignorePatterns": [
    "node_modules",
    ".hutch",
    ".cottontail-tmp",
    "build",
    "dist",
    "artifacts",
    "**/node_modules/**",
    "**/.hutch/**",
    "**/build/**",
    "**/dist/**"
  ]
}
